# Copy this file to .env and fill in your real values.

# Port the app listens on
PORT=3000

# A long random string used to sign login sessions. Change this to anything random.
SESSION_SECRET=change-this-to-a-long-random-string

# The password you will use to log into /admin
ADMIN_PASSWORD=choose-a-strong-password

# --- Supabase (your database + photo storage) ---
# From your Supabase project: Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-KEEP-THIS-SECRET
# Name of the public Storage bucket you create for photos (see README step 2)
SUPABASE_BUCKET=media

# --- Chapa (payments) ---
# From https://dashboard.chapa.co -> Settings -> API Keys
# Use the TEST key while developing, then switch to the LIVE key when you go live.
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx

# The public URL of your deployed site (used for Chapa's redirect/webhook URLs).
# For local testing this can stay as localhost.
APP_BASE_URL=http://localhost:3000
