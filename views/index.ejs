<!DOCTYPE html>
<html lang="<%= lang %>" class="<%= lang === 'am' ? 'lang-am' : '' %>">
<head>
<%- include('partials/_head', { seo: seo, lang: lang }) %>
</head>
<body>

<%- include('partials/_header', { lang: lang, prefix: prefix, home: home, enUrl: enUrl, amUrl: amUrl, content: content }) %>

<main id="main">
<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <div class="eyebrow">
        <span data-en><%= content.hero_eyebrow.en %></span>
        <span data-am><%= content.hero_eyebrow.am %></span>
      </div>
      <h1 data-en><%= content.hero_title.en %></h1>
      <h1 data-am class="block"><%= content.hero_title.am %></h1>
      <p class="lead" data-en><%= content.hero_subtitle.en %></p>
      <p class="lead" data-am><%= content.hero_subtitle.am %></p>
      <div class="hero-ctas">
        <a href="#services" class="btn btn-primary">
          <span data-en>Get a Free Estimate</span>
          <span data-am>ነጻ ግምት ያግኙ</span>
        </a>
        <a href="<%= prefix %>/products" class="btn btn-ghost">
          <span data-en>Download Templates</span>
          <span data-am>ቅጾችን ያውርዱ</span>
        </a>
      </div>
    </div>

    <div class="boq-card">
      <div class="boq-head">
        <div>
          <div class="tag" data-en>LIVE SAMPLE · BILL OF QUANTITIES</div>
          <div class="tag" data-am>ናሙና · የመጠን ዝርዝር (BOQ)</div>
          <div class="title" data-en>Ground Floor — Substructure</div>
          <div class="title" data-am>የመሬት ወለል — መሰረት</div>
        </div>
        <div class="status" data-en>DRAFT No. 003</div>
        <div class="status" data-am>ረቂቅ ቁ. 003</div>
      </div>
      <table class="boq-table">
        <thead>
          <tr>
            <th data-en>Item</th><th data-am>እቃ</th>
            <th data-en>Description</th><th data-am>መግለጫ</th>
            <th data-en>Qty</th><th data-am>ብዛት</th>
            <th data-en>Unit</th><th data-am>ክፍል</th>
            <th class="amt" data-en>Amount (ETB)</th><th class="amt" data-am>መጠን (ብር)</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>01</td>
            <td><span data-en>Site clearance &amp; excavation</span><span data-am>ቦታ ማጽዳት እና ቁፋሮ</span></td>
            <td class="count-amt" data-target="412">412</td>
            <td>m³</td>
            <td class="amt count-amt" data-target="185400">185,400</td>
          </tr>
          <tr>
            <td>02</td>
            <td><span data-en>C-25 foundation concrete</span><span data-am>C-25 የመሰረት ኮንክሪት</span></td>
            <td class="count-amt" data-target="96">96</td>
            <td>m³</td>
            <td class="amt count-amt" data-target="1248000">1,248,000</td>
          </tr>
          <tr>
            <td>03</td>
            <td><span data-en>Reinforcement steel, Ø12–20</span><span data-am>ብረት ማጠናከሪያ Ø12–20</span></td>
            <td class="count-amt" data-target="8.4">8.4</td>
            <td>ton</td>
            <td class="amt count-amt" data-target="672000">672,000</td>
          </tr>
          <tr>
            <td>04</td>
            <td><span data-en>Masonry block wall, 20cm</span><span data-am>ብሎኬት ግድግዳ 20ሳ.ሜ</span></td>
            <td class="count-amt" data-target="210">210</td>
            <td>m²</td>
            <td class="amt count-amt" data-target="294000">294,000</td>
          </tr>
        </tbody>
      </table>
      <div class="boq-total">
        <span class="label" data-en>Estimated Subtotal</span>
        <span class="label" data-am>ግምት ድምር</span>
        <span class="value">ETB <span class="count-amt" data-target="2399400">2,399,400</span></span>
      </div>
    </div>
  </div>
</section>

<div class="strip" aria-hidden="true">
  <div class="strip-track">
    <% for(let i=0;i<2;i++){ %>
    <span><span>◆</span><span data-en>QUANTITY TAKE-OFF</span><span data-am>መጠን ማውጣት</span></span>
    <span><span>◆</span><span data-en>BILL OF QUANTITIES</span><span data-am>የመጠን ዝርዝር (BOQ)</span></span>
    <span><span>◆</span><span data-en>COST ESTIMATION</span><span data-am>የወጪ ግምት</span></span>
    <span><span>◆</span><span data-en>BID &amp; TENDER PREPARATION</span><span data-am>የጨረታ ዝግጅት</span></span>
    <span><span>◆</span><span data-en>CONTRACTOR PAYMENT PROCESSING</span><span data-am>የተቋራጭ ክፍያ ሂደት</span></span>
    <% } %>
  </div>
</div>

<section class="about" id="about">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow"><span data-en>COMPANY PROFILE</span><span data-am>የኩባንያ መገለጫ</span></div>
      <h2 data-en><%= content.about_title.en %></h2>
      <h2 data-am><%= content.about_title.am %></h2>
      <p class="lead" data-en><%= content.about_body.en %></p>
      <p class="lead" data-am><%= content.about_body.am %></p>
    </div>

    <div class="about-grid">
      <div class="about-figure">
        <% if (content.about_image.en) { %>
          <img src="<%= content.about_image.en %>" alt="<%= content.about_title.en %>" loading="lazy" decoding="async">
        <% } else { %>
          <div class="cap" data-en>[ Project photo — add one in the admin panel ]</div>
          <div class="cap" data-am>[ የፕሮጀክት ፎቶ — ከአስተዳደር ፓነል ይጨምሩ ]</div>
        <% } %>
      </div>
      <div>
        <ul class="about-list">
          <% aboutFeatures.forEach(function(f, i){ %>
          <li>
            <span class="num"><%= String(i+1).padStart(2,'0') %></span>
            <div class="txt">
              <strong data-en><%= f.title_en %></strong>
              <strong data-am><%= f.title_am %></strong>
              <span data-en><%= f.body_en %></span>
              <span data-am><%= f.body_am %></span>
            </div>
          </li>
          <% }) %>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="services" id="services">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow"><span data-en>WHAT WE OFFER</span><span data-am>የምንሰጠው አገልግሎት</span></div>
      <h2 data-en>Professional Services</h2>
      <h2 data-am>ሙያዊ አገልግሎቶች</h2>
      <p class="lead" data-en>Five services that follow the real life of a project, from a stack of drawings to a signed-off payment.</p>
      <p class="lead" data-am>ከንድፍ ወረቀቶች እስከ ተፈራርሞ ወደ ተቀመጠ ክፍያ ድረስ ፕሮጀክትን የሚከተሉ አገልግሎቶች።</p>
    </div>

    <div class="svc-grid">
      <% services.forEach(function(s, i){ %>
      <div class="svc-card">
        <span class="num"><%= String(i+1).padStart(2,'0') %> / <%= String(services.length).padStart(2,'0') %></span>
        <h3><a href="<%= prefix %>/services/<%= s.slug %>"><span data-en><%= s.title_en %></span><span data-am><%= s.title_am || s.title_en %></span></a></h3>
        <p data-en><%= s.desc_en %></p>
        <p data-am><%= s.desc_am || s.desc_en %></p>
        <div class="price"><span data-en>From </span><span data-am>ከ</span><%= s.price.toLocaleString('en-US') %> <%= s.currency %></div>
        <div class="svc-actions">
          <a class="btn btn-primary" href="/checkout/<%= s.id %>">
            <span data-en>Buy Now</span>
            <span data-am>ይግዙ</span>
          </a>
          <a class="more" href="<%= prefix %>/services/<%= s.slug %>">
            <span data-en>Details</span>
            <span data-am>ዝርዝር</span>
          </a>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="products" id="templates">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow"><span data-en>DOWNLOADS</span><span data-am>ማውረጃዎች</span></div>
      <h2 data-en>BOQ, Cost &amp; Contract Templates</h2>
      <h2 data-am>የBOQ፣ የወጪ እና የውል ቅጾች</h2>
      <p class="lead" data-en>Excel and Word files we use ourselves. Pay with Chapa and download straight away.</p>
      <p class="lead" data-am>እኛ ራሳችን የምንጠቀምባቸው የExcel እና የWord ፋይሎች። በChapa ይክፈሉ እና ወዲያውኑ ያውርዱ።</p>
    </div>
    <% if (products.length === 0) { %>
    <p class="empty-note" data-en>New templates are being added. Check back soon, or contact us for a custom BOQ or cost sheet.</p>
    <p class="empty-note" data-am>አዳዲስ ቅጾች በመጨመር ላይ ናቸው። በቅርቡ ይመለሱ፣ ወይም ለብጁ BOQ ወይም የወጪ ሉህ ያግኙን።</p>
    <% } else { %>
    <div class="prod-grid">
      <% products.forEach(function(p){ %>
      <%- include('partials/_productcard', { lang: lang, prefix: prefix, p: p }) %>
      <% }) %>
    </div>
    <div class="section-more">
      <a class="btn btn-outline" href="<%= prefix %>/products"><span data-en>See all templates</span><span data-am>ሁሉንም ቅጾች ይመልከቱ</span></a>
    </div>
    <% } %>
  </div>
</section>

<section class="process" id="process">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow"><span data-en>HOW WE WORK</span><span data-am>የስራ ሂደታችን</span></div>
      <h2 data-en>From First Call To Signed Document</h2>
      <h2 data-am>ከመጀመሪያው ጥሪ እስከ ተፈራርሞ ሰነድ</h2>
    </div>
    <div class="proc-track">
      <% process.forEach(function(p, i){ %>
      <div class="proc-step">
        <span class="num"><%= String(i+1).padStart(2,'0') %></span>
        <h3 data-en><%= p.title_en %></h3>
        <h3 data-am><%= p.title_am %></h3>
        <p data-en><%= p.body_en %></p>
        <p data-am><%= p.body_am %></p>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="why">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow"><span data-en>WHY US</span><span data-am>ለምን እኛን</span></div>
      <h2 data-en>Built On Local Numbers</h2>
      <h2 data-am>በአካባቢያዊ አሃዞች ላይ የተመሰረተ</h2>
    </div>
    <div class="why-grid">
      <% whyUs.forEach(function(w){ %>
      <div class="why-card">
        <h3 data-en><%= w.title_en %></h3>
        <h3 data-am><%= w.title_am %></h3>
        <p data-en><%= w.body_en %></p>
        <p data-am><%= w.body_am %></p>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="projects" id="projects">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow"><span data-en>SELECTED WORK</span><span data-am>የተመረጡ ስራዎች</span></div>
      <h2 data-en>Recent Projects</h2>
      <h2 data-am>የቅርብ ጊዜ ፕሮጀክቶች</h2>
    </div>
    <div class="proj-grid">
      <% if (gallery.length === 0) { %>
        <div class="proj-tile"><span data-en>[ Add project photos in the admin panel ]</span><span data-am>[ ከአስተዳደር ፓነል የፕሮጀክት ፎቶዎችን ይጨምሩ ]</span></div>
      <% } %>
      <% gallery.forEach(function(g){ %>
      <div class="proj-tile">
        <img src="<%= g.image %>" alt="<%= g.caption_en || (content.company_name.en + ' project') %>" loading="lazy" decoding="async">
        <% if (g.caption_en || g.caption_am) { %>
          <span class="cap" data-en><%= g.caption_en %></span>
          <span class="cap" data-am><%= g.caption_am %></span>
        <% } %>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="cta-band" id="call">
  <div class="wrap inner">
    <div>
      <h2 data-en>Need quick advice? Talk to an expert.</h2>
      <h2 data-am>ፈጣን ምክር ይፈልጋሉ? ከባለሙያ ጋር ይወያዩ።</h2>
    </div>
    <a class="btn btn-primary" href="<%= prefix %>/call"><span data-en>Book a call</span><span data-am>ጥሪ ያስይዙ</span></a>
  </div>
</section>

<section class="contact" id="contact">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow"><span data-en>GET IN TOUCH</span><span data-am>ያግኙን</span></div>
      <h2 data-en>Contact Us</h2>
      <h2 data-am>ያግኙን</h2>
      <p class="lead" data-en>Pick a service above to request a quote and pay securely with Chapa, or reach out directly.</p>
      <p class="lead" data-am>ከላይ ካሉት አገልግሎቶች አንዱን በመምረጥ ዋጋ ይጠይቁ እና በChapa በደህንነት ይክፈሉ፣ ወይም በቀጥታ ያግኙን።</p>
    </div>

    <div class="contact-grid">
      <div class="contact-info">
        <dl>
          <div>
            <dt data-en>Office</dt><dt data-am>ቢሮ</dt>
            <dd data-en><%= content.contact_office.en %></dd>
            <dd data-am><%= content.contact_office.am || content.contact_office.en %></dd>
          </div>
          <div>
            <dt data-en>Phone</dt><dt data-am>ስልክ</dt>
            <dd><a href="tel:<%= content.contact_phone.en.replace(/[^+\d]/g, '') %>"><%= content.contact_phone.en %></a></dd>
          </div>
          <div>
            <dt data-en>Email</dt><dt data-am>ኢሜይል</dt>
            <dd><a href="mailto:<%= content.contact_email.en %>"><%= content.contact_email.en %></a></dd>
          </div>
          <div>
            <dt data-en>Hours</dt><dt data-am>የስራ ሰዓት</dt>
            <dd data-en><%= content.contact_hours.en %></dd>
            <dd data-am><%= content.contact_hours.am || content.contact_hours.en %></dd>
          </div>
        </dl>
      </div>
      <div>
        <p class="lead" data-en>Prefer to talk first? Call or email us, and we'll help you choose the right service.</p>
        <p class="lead" data-am>መጀመሪያ ማውራት ይፈልጋሉ? ይደውሉልን ወይም ኢሜይል ይላኩልን፤ ትክክለኛውን አገልግሎት እንድመርጡ እንረዳዎታለን።</p>
        <div class="contact-actions">
          <a class="btn btn-primary" href="tel:<%= content.contact_phone.en.replace(/[^+\d]/g, '') %>"><span data-en>Call us</span><span data-am>ይደውሉልን</span></a>
          <a class="btn btn-outline" href="mailto:<%= content.contact_email.en %>"><span data-en>Send an email</span><span data-am>ኢሜይል ይላኩ</span></a>
        </div>
      </div>
    </div>
  </div>
</section>

</main>

<%- include('partials/_footer', { lang: lang, prefix: prefix, home: home, content: content, services: services }) %>

<script>
function formatNum(n){ return Math.round(n).toLocaleString('en-US'); }
// The real numbers are in the HTML (good for search engines and no-JS visitors);
// when motion is allowed they count up from zero for the visitor.
var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
if(!reduceMotion){ document.querySelectorAll('.count-amt').forEach(function(el){ el.textContent = '0'; }); }
function animateCounts(){
  if(reduceMotion) return;
  document.querySelectorAll('.count-amt').forEach(function(el){
    var target = parseFloat(el.getAttribute('data-target'));
    var isDecimal = target % 1 !== 0;
    var finalText = isDecimal ? target.toFixed(1) : formatNum(target);
    var start = null;
    var duration = 1400;
    function step(ts){
      if(!start) start = ts;
      var progress = Math.min((ts - start) / duration, 1);
      var eased = 1 - Math.pow(1 - progress, 3);
      var val = target * eased;
      el.textContent = isDecimal ? val.toFixed(1) : formatNum(val);
      if(progress < 1) requestAnimationFrame(step);
      else el.textContent = finalText;
    }
    requestAnimationFrame(step);
  });
}
window.addEventListener('load', function(){ setTimeout(animateCounts, 300); });
</script>

</body>
</html>
