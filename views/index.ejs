<!DOCTYPE html>
<html lang="<%= lang %>" class="<%= lang === 'am' ? 'lang-am' : '' %>">
<head>
<%- include('partials/_head', { seo: seo, lang: lang }) %>
</head>
<body>

<%- include('partials/_header', { lang: lang, prefix: prefix, home: home, enUrl: enUrl, amUrl: amUrl, content: content }) %>

<main id="main">
<% sections.forEach(function(s){ %>
<%- include('section-' + s.kind, { lang: lang, prefix: prefix, home: home, content: content, services: services, aboutFeatures: aboutFeatures, whyUs: whyUs, process: process, gallery: gallery, products: products, categories: categories, callInfo: callInfo, section: s }) %>
<% }) %>
</main>

<%- include('partials/_footer', { lang: lang, prefix: prefix, home: home, content: content, services: services }) %>

<script>
function formatNum(n){ return Math.round(n).toLocaleString('en-US'); }
// The real numbers are in the HTML (good for search engines and no-JS visitors);
// when motion is allowed they count up from zero for the visitor.
var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
if(!reduceMotion){ document.querySelectorAll('.count-amt').forEach(function(el){ el.textContent = '0'; }); }
function animateCounts(){
  if(reduceMotion) return;
  document.querySelectorAll('.count-amt').forEach(function(el){
    var target = parseFloat(el.getAttribute('data-target'));
    var isDecimal = target % 1 !== 0;
    var finalText = isDecimal ? target.toFixed(1) : formatNum(target);
    var start = null;
    var duration = 1400;
    function step(ts){
      if(!start) start = ts;
      var progress = Math.min((ts - start) / duration, 1);
      var eased = 1 - Math.pow(1 - progress, 3);
      var val = target * eased;
      el.textContent = isDecimal ? val.toFixed(1) : formatNum(val);
      if(progress < 1) requestAnimationFrame(step);
      else el.textContent = finalText;
    }
    requestAnimationFrame(step);
  });
}
window.addEventListener('load', function(){ setTimeout(animateCounts, 300); });
</script>

</body>
</html>
