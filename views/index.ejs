<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= content.company_name.en %> — Construction &amp; Quantity Surveying, Addis Ababa</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Noto+Sans+Ethiopic:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>

<header>
  <div class="wrap nav">
    <div class="brand">
      <span class="word"><%= content.company_name.en.toUpperCase() %></span>
      <span class="sub" data-en>CONSTRUCTION · PLC</span>
      <span class="sub" data-am>ግንባታ · አ.ማ</span>
    </div>
    <nav class="nav-links">
      <a class="nav-link" href="#about" data-en>Company</a>
      <a class="nav-link" href="#about" data-am>ኩባንያ</a>
      <a class="nav-link" href="#services" data-en>Services</a>
      <a class="nav-link" href="#services" data-am>አገልግሎቶች</a>
      <a class="nav-link" href="#process" data-en>Process</a>
      <a class="nav-link" href="#process" data-am>የስራ ሂደት</a>
      <a class="nav-link" href="#projects" data-en>Projects</a>
      <a class="nav-link" href="#projects" data-am>ፕሮጀክቶች</a>
      <a class="nav-link" href="#contact" data-en>Contact</a>
      <a class="nav-link" href="#contact" data-am>አግኙን</a>
    </nav>
    <div class="nav-actions">
      <div class="lang-toggle">
        <button id="btn-en" class="active" onclick="setLang('en')">EN</button>
        <button id="btn-am" onclick="setLang('am')">አማ</button>
      </div>
      <a href="#services" class="btn btn-primary">
        <span data-en>Request a Quote</span>
        <span data-am>ዋጋ ይጠይቁ</span>
      </a>
    </div>
  </div>
</header>

<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <div class="eyebrow">
        <span data-en><%= content.hero_eyebrow.en %></span>
        <span data-am><%= content.hero_eyebrow.am %></span>
      </div>
      <h1 data-en><%= content.hero_title.en %></h1>
      <h1 data-am class="block"><%= content.hero_title.am %></h1>
      <p class="lead" data-en><%= content.hero_subtitle.en %></p>
      <p class="lead" data-am><%= content.hero_subtitle.am %></p>
      <div class="hero-ctas">
        <a href="#services" class="btn btn-primary">
          <span data-en>Get a Free Estimate</span>
          <span data-am>ነጻ ግምት ያግኙ</span>
        </a>
        <a href="#services" class="btn btn-ghost">
          <span data-en>View Services</span>
          <span data-am>አገልግሎቶችን ይመልከቱ</span>
        </a>
      </div>
    </div>

    <div class="boq-card">
      <div class="boq-head">
        <div>
          <div class="tag" data-en>LIVE SAMPLE · BILL OF QUANTITIES</div>
          <div class="tag" data-am>ናሙና · የመጠን ዝርዝር (BOQ)</div>
          <div class="title" data-en>Ground Floor — Substructure</div>
          <div class="title" data-am>የመሬት ወለል — መሰረት</div>
        </div>
        <div class="status" data-en>DRAFT No. 003</div>
        <div class="status" data-am>ረቂቅ ቁ. 003</div>
      </div>
      <table class="boq-table">
        <thead>
          <tr>
            <th data-en>Item</th><th data-am>እቃ</th>
            <th data-en>Description</th><th data-am>መግለጫ</th>
            <th data-en>Qty</th><th data-am>ብዛት</th>
            <th data-en>Unit</th><th data-am>ክፍል</th>
            <th class="amt" data-en>Amount (ETB)</th><th class="amt" data-am>መጠን (ብር)</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>01</td>
            <td><span data-en>Site clearance &amp; excavation</span><span data-am>ቦታ ማጽዳት እና ቁፋሮ</span></td>
            <td class="count-amt" data-target="412">0</td>
            <td>m³</td>
            <td class="amt count-amt" data-target="185400">0</td>
          </tr>
          <tr>
            <td>02</td>
            <td><span data-en>C-25 foundation concrete</span><span data-am>C-25 የመሰረት ኮንክሪት</span></td>
            <td class="count-amt" data-target="96">0</td>
            <td>m³</td>
            <td class="amt count-amt" data-target="1248000">0</td>
          </tr>
          <tr>
            <td>03</td>
            <td><span data-en>Reinforcement steel, Ø12–20</span><span data-am>ብረት ማጠናከሪያ Ø12–20</span></td>
            <td class="count-amt" data-target="8.4">0</td>
            <td>ton</td>
            <td class="amt count-amt" data-target="672000">0</td>
          </tr>
          <tr>
            <td>04</td>
            <td><span data-en>Masonry block wall, 20cm</span><span data-am>ብሎኬት ግድግዳ 20ሳ.ሜ</span></td>
            <td class="count-amt" data-target="210">0</td>
            <td>m²</td>
            <td class="amt count-amt" data-target="294000">0</td>
          </tr>
        </tbody>
      </table>
      <div class="boq-total">
        <span class="label" data-en>Estimated Subtotal</span>
        <span class="label" data-am>ግምት ድምር</span>
        <span class="value">ETB <span class="count-amt" data-target="2399400">0</span></span>
      </div>
    </div>
  </div>
</section>

<div class="strip">
  <div class="strip-track">
    <% for(let i=0;i<2;i++){ %>
    <span><span>◆</span><span data-en>QUANTITY TAKE-OFF</span><span data-am>መጠን ማውጣት</span></span>
    <span><span>◆</span><span data-en>BILL OF QUANTITIES</span><span data-am>የመጠን ዝርዝር (BOQ)</span></span>
    <span><span>◆</span><span data-en>COST ESTIMATION</span><span data-am>የወጪ ግምት</span></span>
    <span><span>◆</span><span data-en>BID &amp; TENDER PREPARATION</span><span data-am>የጨረታ ዝግጅት</span></span>
    <span><span>◆</span><span data-en>CONTRACTOR PAYMENT PROCESSING</span><span data-am>የተቋራጭ ክፍያ ሂደት</span></span>
    <% } %>
  </div>
</div>

<section class="about" id="about">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow"><span data-en>COMPANY PROFILE</span><span data-am>የኩባንያ መገለጫ</span></div>
      <h2 data-en><%= content.about_title.en %></h2>
      <h2 data-am><%= content.about_title.am %></h2>
      <p class="lead" data-en><%= content.about_body.en %></p>
      <p class="lead" data-am><%= content.about_body.am %></p>
    </div>

    <div class="about-grid">
      <div class="about-figure">
        <% if (content.about_image.en) { %>
          <img src="<%= content.about_image.en %>" alt="<%= content.about_title.en %>">
        <% } else { %>
          <div class="cap" data-en>[ Project photo — add one in the admin panel ]</div>
          <div class="cap" data-am>[ የፕሮጀክት ፎቶ — ከአስተዳደር ፓነል ይጨምሩ ]</div>
        <% } %>
      </div>
      <div>
        <ul class="about-list">
          <% aboutFeatures.forEach(function(f, i){ %>
          <li>
            <span class="num"><%= String(i+1).padStart(2,'0') %></span>
            <div class="txt">
              <strong data-en><%= f.title_en %></strong>
              <strong data-am><%= f.title_am %></strong>
              <span data-en><%= f.body_en %></span>
              <span data-am><%= f.body_am %></span>
            </div>
          </li>
          <% }) %>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="services" id="services">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow"><span data-en>WHAT WE OFFER</span><span data-am>የምንሰጠው አገልግሎት</span></div>
      <h2 data-en>Professional Services</h2>
      <h2 data-am>ሙያዊ አገልግሎቶች</h2>
      <p class="lead" data-en>Five services that follow the real life of a project, from a stack of drawings to a signed-off payment.</p>
      <p class="lead" data-am>ከንድፍ ወረቀቶች እስከ ተፈራርሞ ወደ ተቀመጠ ክፍያ ድረስ ፕሮጀክትን የሚከተሉ አገልግሎቶች።</p>
    </div>

    <div class="svc-grid">
      <% services.forEach(function(s, i){ %>
      <div class="svc-card">
        <span class="num"><%= String(i+1).padStart(2,'0') %> / <%= String(services.length).padStart(2,'0') %></span>
        <h3 data-en><%= s.title_en %></h3>
        <h3 data-am><%= s.title_am %></h3>
        <p data-en><%= s.desc_en %></p>
        <p data-am><%= s.desc_am %></p>
        <div class="price"><span data-en>From </span><span data-am>ከ</span><%= s.price.toLocaleString('en-US') %> <%= s.currency %></div>
        <a class="btn btn-primary" href="/checkout/<%= s.id %>">
          <span data-en>Buy Now</span>
          <span data-am>ይግዙ</span>
        </a>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="process" id="process">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow"><span data-en>HOW WE WORK</span><span data-am>የስራ ሂደታችን</span></div>
      <h2 data-en>From First Call To Signed Document</h2>
      <h2 data-am>ከመጀመሪያው ጥሪ እስከ ተፈራርሞ ሰነድ</h2>
    </div>
    <div class="proc-track">
      <% process.forEach(function(p, i){ %>
      <div class="proc-step">
        <span class="num"><%= String(i+1).padStart(2,'0') %></span>
        <h3 data-en><%= p.title_en %></h3>
        <h3 data-am><%= p.title_am %></h3>
        <p data-en><%= p.body_en %></p>
        <p data-am><%= p.body_am %></p>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="why">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow"><span data-en>WHY US</span><span data-am>ለምን እኛን</span></div>
      <h2 data-en>Built On Local Numbers</h2>
      <h2 data-am>በአካባቢያዊ አሃዞች ላይ የተመሰረተ</h2>
    </div>
    <div class="why-grid">
      <% whyUs.forEach(function(w){ %>
      <div class="why-card">
        <h3 data-en><%= w.title_en %></h3>
        <h3 data-am><%= w.title_am %></h3>
        <p data-en><%= w.body_en %></p>
        <p data-am><%= w.body_am %></p>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="projects" id="projects">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow"><span data-en>SELECTED WORK</span><span data-am>የተመረጡ ስራዎች</span></div>
      <h2 data-en>Recent Projects</h2>
      <h2 data-am>የቅርብ ጊዜ ፕሮጀክቶች</h2>
    </div>
    <div class="proj-grid">
      <% if (gallery.length === 0) { %>
        <div class="proj-tile"><span data-en>[ Add project photos in the admin panel ]</span><span data-am>[ ከአስተዳደር ፓነል የፕሮጀክት ፎቶዎችን ይጨምሩ ]</span></div>
      <% } %>
      <% gallery.forEach(function(g){ %>
      <div class="proj-tile">
        <img src="<%= g.image %>" alt="">
        <% if (g.caption_en || g.caption_am) { %>
          <span class="cap" data-en><%= g.caption_en %></span>
          <span class="cap" data-am><%= g.caption_am %></span>
        <% } %>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="contact" id="contact">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow"><span data-en>GET IN TOUCH</span><span data-am>ያግኙን</span></div>
      <h2 data-en>Contact Us</h2>
      <h2 data-am>ያግኙን</h2>
      <p class="lead" data-en>Pick a service above to request a quote and pay securely with Chapa, or reach out directly.</p>
      <p class="lead" data-am>ከላይ ካሉት አገልግሎቶች አንዱን በመምረጥ ዋጋ ይጠይቁ እና በChapa በደህንነት ይክፈሉ፣ ወይም በቀጥታ ያግኙን።</p>
    </div>

    <div class="contact-grid">
      <div class="contact-info">
        <dl>
          <div>
            <dt data-en>Office</dt><dt data-am>ቢሮ</dt>
            <dd data-en><%= content.contact_office.en %></dd>
            <dd data-am><%= content.contact_office.am %></dd>
          </div>
          <div>
            <dt data-en>Phone</dt><dt data-am>ስልክ</dt>
            <dd><%= content.contact_phone.en %></dd>
          </div>
          <div>
            <dt data-en>Email</dt><dt data-am>ኢሜይል</dt>
            <dd><%= content.contact_email.en %></dd>
          </div>
          <div>
            <dt data-en>Hours</dt><dt data-am>የስራ ሰዓት</dt>
            <dd data-en><%= content.contact_hours.en %></dd>
            <dd data-am><%= content.contact_hours.am %></dd>
          </div>
        </dl>
      </div>
      <div>
        <div class="svc-grid" style="border:1px solid var(--line-dark); background:var(--line-dark); grid-template-columns:1fr;">
        </div>
        <p class="lead" data-en>Prefer to talk first? Call or email us, and we'll help you choose the right service.</p>
        <p class="lead" data-am>መጀመሪያ ማውራት ይፈልጋሉ? ይደውሉልን ወይም ኢሜይል ይላኩልን፤ ትክክለኛውን አገልግሎት እንድመርጡ እንረዳዎታለን።</p>
      </div>
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <div class="word"><%= content.company_name.en.toUpperCase() %></div>
        <p data-en><%= content.footer_tagline.en %></p>
        <p data-am><%= content.footer_tagline.am %></p>
      </div>
      <div class="foot-col">
        <h4 data-en>Company</h4><h4 data-am>ኩባንያ</h4>
        <a href="#about" data-en>About</a><a href="#about" data-am>ስለ እኛ</a>
        <a href="#projects" data-en>Projects</a><a href="#projects" data-am>ፕሮጀክቶች</a>
      </div>
      <div class="foot-col">
        <h4 data-en>Services</h4><h4 data-am>አገልግሎቶች</h4>
        <a href="#services" data-en>All Services</a><a href="#services" data-am>ሁሉም አገልግሎቶች</a>
      </div>
      <div class="foot-col">
        <h4 data-en>Contact</h4><h4 data-am>ያግኙን</h4>
        <a href="#contact" data-en>Get an Estimate</a><a href="#contact" data-am>ግምት ያግኙ</a>
      </div>
    </div>
    <div class="foot-bottom">
      <span data-en>© 2026 <%= content.company_name.en %>. All rights reserved.</span>
      <span data-am>© 2026 <%= content.company_name.am %> ሁሉም መብቶች የተጠበቁ ናቸው።</span>
      <span data-en>Addis Ababa, Ethiopia</span>
      <span data-am>አዲስ አበባ፣ ኢትዮጵያ</span>
    </div>
  </div>
</footer>

<script>
function setLang(lang){
  const root = document.getElementById('html-root');
  if(lang === 'am'){
    root.classList.add('lang-am');
    document.getElementById('btn-am').classList.add('active');
    document.getElementById('btn-en').classList.remove('active');
    root.setAttribute('lang','am');
  } else {
    root.classList.remove('lang-am');
    document.getElementById('btn-en').classList.add('active');
    document.getElementById('btn-am').classList.remove('active');
    root.setAttribute('lang','en');
  }
}
function formatNum(n){ return Math.round(n).toLocaleString('en-US'); }
function animateCounts(){
  document.querySelectorAll('.count-amt').forEach(el => {
    const target = parseFloat(el.getAttribute('data-target'));
    const isDecimal = target % 1 !== 0;
    let start = null;
    const duration = 1400;
    function step(ts){
      if(!start) start = ts;
      const progress = Math.min((ts - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const val = target * eased;
      el.textContent = isDecimal ? val.toFixed(1) : formatNum(val);
      if(progress < 1) requestAnimationFrame(step);
      else el.textContent = isDecimal ? target.toFixed(1) : formatNum(target);
    }
    requestAnimationFrame(step);
  });
}
window.addEventListener('load', () => setTimeout(animateCounts, 300));
</script>

</body>
</html>
