    <%- item('call-settings', '/admin/call-settings', 'sliders', 'Call Settings') %>

    <div class="nav-group">Sales</div>
    <%- item('orders', '/admin/orders', 'bag', 'Orders') %>
    <%- item('payments', '/admin/payments', 'card', 'Payments') %>
  </nav>

  <div class="side-foot">
    <a href="/" target="_blank" rel="noopener"><%- ico('ext') %><span>View site</span></a>
    <form method="POST" action="/admin/logout"><button type="submit"><%- ico('out') %><span>Log out</span></button></form>
  </div>
</aside>
