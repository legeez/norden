function ico(n){ return '<svg viewBox="0 0 24 24" aria-hidden="true">' + P[n] + '</svg>'; }
function item(key, href, icon, label){
  return '<a href="' + href + '" class="' + (active === key ? 'active' : '') + '">' + ico(icon) + '<span>' + label + '</span></a>';
}
%>
<aside class="admin-sidebar">
  <div class="brand"><span class="logo">N</span><span class="brand-text"><span class="name">Norden</span><span class="sub">Admin panel</span></span></div>

  <nav class="side-nav">
    <%- item('dashboard', '/admin', 'home', 'Dashboard') %>

    <div class="nav-group">Website</div>
    <%- item('content', '/admin/content', 'file', 'Site Content') %>
    <%- item('services', '/admin/services', 'tag', 'Services &amp; Prices') %>
    <%- item('products', '/admin/products', 'box', 'Products &amp; Files') %>
    <%- item('blocks', '/admin/blocks/about_features', 'layout', 'Page Sections') %>
    <%- item('gallery', '/admin/gallery', 'image', 'Project Gallery') %>

