<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard — Norden Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="admin-shell">
  <%- include('_sidebar', { active: 'dashboard' }) %>
  <div class="admin-main">
    <h1>Dashboard</h1>
    <p class="admin-sub">Welcome back. Here is a quick look at your site, orders and calls.</p>

    <% if (newCalls > 0) { %>
    <div class="notice" style="display:flex; justify-content:space-between; gap:12px; flex-wrap:wrap; align-items:center;">
      <span><strong><%= newCalls %></strong> new paid call<%= newCalls === 1 ? '' : 's' %> waiting.</span>
      <a href="/admin/calls" class="btn btn-primary">Open Calls</a>
    </div>
    <% } %>

    <div class="stat-grid">
      <div class="stat"><span class="chip"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg></span><div><div class="num"><%= serviceCount %></div><div class="lbl">Active Services</div></div></div>
      <div class="stat"><span class="chip ink"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></span><div><div class="num"><%= orderCount %></div><div class="lbl">Total Orders</div></div></div>
      <div class="stat"><span class="chip green"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></span><div><div class="num"><%= paidCount %></div><div class="lbl">Paid Orders</div></div></div>
      <div class="stat"><span class="chip amber"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg></span><div><div class="num">ETB <%= revenue.toLocaleString('en-US') %></div><div class="lbl">Revenue Collected</div></div></div>
    </div>

    <div class="section-title">Quick actions</div>
    <div class="quick">
      <a href="/admin/calls"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg><span>Manage calls</span></a>
      <a href="/admin/services"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg><span>Edit services</span></a>
      <a href="/admin/payments"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg><span>Payments</span></a>
      <a href="/" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg><span>View website</span></a>
    </div>

    <div class="card">
      <h2>Recent Orders</h2>
      <% if (recentOrders.length === 0) { %>
        <p class="hint">No orders yet. Orders will appear here once a customer pays for a service.</p>
      <% } else { %>
      <table>
        <tr><th>Customer</th><th>Service</th><th>Amount</th><th>Status</th></tr>
        <% recentOrders.forEach(function(o){ %>
        <tr>
          <td><%= o.customer_name %></td>
          <td><%= o.service_title %></td>
          <td><%= o.amount.toLocaleString('en-US') %> <%= o.currency %></td>
          <td><span class="badge badge-<%= o.status %>"><%= o.status %></span></td>
        </tr>
        <% }) %>
      </table>
      <% } %>
    </div>

    <div class="card">
      <h2>Payments Setup</h2>
      <p class="hint" style="margin-top:0;">Template and call payments use your Chapa secret key. Add it, replace it or test it in <a href="/admin/payments" style="text-decoration:underline;">Payments</a>. The saved key is never shown in full.</p>
    </div>
  </div>
</div>
</body>
</html>
