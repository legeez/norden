<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Call Settings — Norden Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="admin-shell">
  <%- include('_sidebar', { active: 'call-settings' }) %>
  <div class="admin-main">
    <h1>Call Settings</h1>
    <p class="admin-sub">Default prices (each call type can override them in <a href="/admin/call-types" style="text-decoration:underline;">Call Types</a>), working hours, numbers and notifications for the call service. All times are Addis Ababa time.</p>

    <% if (!ready) { %><div class="error">The call tables do not exist yet. Run <code>migrations/003_call_service.sql</code> in the Supabase SQL Editor, then reload this page.</div><% } %>
    <% if (saved) { %><div class="notice">Settings saved.</div><% } %>
    <% if (msg) { %><div class="notice" style="white-space:pre-line;"><%= msg %></div><% } %>

    <form method="POST" action="/admin/call-settings">
      <div class="card">
        <h2>Live call (quick and short)</h2>
        <label class="check"><input type="checkbox" name="live_enabled" <%= s.live_enabled === 'on' ? 'checked' : '' %>> Online now (customers can pay and call you)</label>
        <div class="row2">
          <div><label>Default price</label><input type="number" step="0.01" min="0" name="live_price" value="<%= s.live_price %>"></div>
          <div><label>Default length (minutes)</label><input type="number" min="1" max="120" name="live_minutes" value="<%= s.live_minutes %>"></div>
        </div>
        <label>Call buttons stay active for (minutes after paying)</label>
        <input type="number" min="5" max="1440" name="live_window_min" value="<%= s.live_window_min %>">
        <p class="hint">The numbers below are shown to customers only after they have paid.</p>
        <div class="row2">
          <div><label>Your phone number</label><input type="text" name="call_phone" value="<%= s.call_phone %>" placeholder="+251 9..."></div>
          <div><label>Your WhatsApp number</label><input type="text" name="call_whatsapp" value="<%= s.call_whatsapp %>" placeholder="+251 9..."></div>
        </div>
        <label class="check"><input type="checkbox" name="channel_phone" <%= s.channel_phone === 'on' ? 'checked' : '' %>> Offer phone calls</label>
        <label class="check"><input type="checkbox" name="channel_whatsapp" <%= s.channel_whatsapp === 'on' ? 'checked' : '' %>> Offer WhatsApp calls</label>
      </div>

      <div class="card">
        <h2>Scheduled call</h2>
        <label class="check"><input type="checkbox" name="scheduled_enabled" <%= s.scheduled_enabled === 'on' ? 'checked' : '' %>> Accept scheduled calls</label>
        <div class="row2">
          <div><label>Default price</label><input type="number" step="0.01" min="0" name="scheduled_price" value="<%= s.scheduled_price %>"></div>
          <div><label>Slot length (minutes)</label><input type="number" min="10" max="240" name="slot_minutes" value="<%= s.slot_minutes %>"></div>
        </div>
        <div class="row2">
          <div><label>Minimum notice (hours)</label><input type="number" min="0" max="168" name="min_notice_hours" value="<%= s.min_notice_hours %>"></div>
          <div><label>Book up to (days ahead)</label><input type="number" min="1" max="60" name="max_days_ahead" value="<%= s.max_days_ahead %>"></div>
        </div>
        <label>Currency</label>
        <input type="text" name="currency" value="<%= s.currency %>" style="max-width:120px;">
        <h2 style="margin-top:8px;">Working days and hours</h2>
        <% days.forEach(function(d){ %>
        <div class="day-row">
          <label class="check" style="margin:0;"><input type="checkbox" name="<%= d.key %>_on" <%= s[d.key + '_on'] === 'on' ? 'checked' : '' %>> <%= d.en %></label>
          <input type="time" name="<%= d.key %>_start" value="<%= s[d.key + '_start'] %>">
          <span>to</span>
          <input type="time" name="<%= d.key %>_end" value="<%= s[d.key + '_end'] %>">
        </div>
        <% }) %>
      </div>

      <div class="card">
        <h2>Notifications for new paid calls</h2>
        <label class="check"><input type="checkbox" name="notify_admin" <%= s.notify_admin === 'on' ? 'checked' : '' %>> Show new calls on the admin dashboard</label>
        <label class="check"><input type="checkbox" name="notify_telegram" <%= s.notify_telegram === 'on' ? 'checked' : '' %>> Send me a Telegram message</label>
        <label>Telegram chat id</label>
        <input type="text" name="telegram_chat_id" value="<%= s.telegram_chat_id %>" placeholder="e.g. 123456789">
        <p class="hint">Bot token secret: <strong><%= tg ? 'set' : 'NOT set (TELEGRAM_BOT_TOKEN)' %></strong></p>
        <label class="check"><input type="checkbox" name="notify_email" <%= s.notify_email === 'on' ? 'checked' : '' %>> Send me an email</label>
        <label>Email address to notify</label>
        <input type="email" name="notify_email_to" value="<%= s.notify_email_to %>">
        <p class="hint">Email key secret: <strong><%= mail ? 'set' : 'NOT set (RESEND_API_KEY)' %></strong></p>
        <div class="btn-row">
          <button type="submit" class="btn btn-primary">Save settings</button>
          <button type="submit" class="btn btn-outline" formaction="/admin/call-settings/test">Save and send a test notification</button>
        </div>
      </div>
    </form>
  </div>
</div>
</body>
</html>
