<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<title>Products — Norden Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="admin-shell">
  <%- include('_sidebar', { active: 'products' }) %>
  <div class="admin-main">
    <h1>Products &amp; Files</h1>
    <p class="admin-sub">Excel, Word and PDF files customers buy and download. Files are stored privately — only people who have paid get a link.</p>

    <% if (saved) { %><div class="notice">Saved.</div><% } %>
    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <% if (setupNeeded) { %><div class="error">The products table does not exist yet. Run <strong>migrations/002_products_and_seo.sql</strong> in the Supabase SQL Editor, create the private <strong>products</strong> storage bucket, then reload this page.</div><% } %>

    <% if (storage && storage.ok && !storage.isPublic) { %><div class="notice">File storage is ready and private.</div><% } %>
    <% if (storage && storage.ok && storage.isPublic) { %><div class="error">The <strong>products</strong> storage bucket is PUBLIC, so anyone with a file link could open it without paying. In Supabase → Storage → products → Edit bucket, turn off "Public bucket".</div><% } %>
    <% if (storage && !storage.ok) { %><div class="error">File storage problem: <%= storage.message %></div><% } %>

    <% products.forEach(function(p){ %>
    <div class="card">
      <form method="POST" action="/admin/products/<%= p.id %>/update" enctype="multipart/form-data">
        <div class="lang-col">
          <div><label>Title (English)</label><input type="text" name="title_en" value="<%= p.title_en %>"></div>
          <div><label>Title (Amharic)</label><input type="text" name="title_am" value="<%= p.title_am %>"></div>
        </div>
        <div class="lang-col">
          <div><label>Description (English)</label><textarea name="desc_en" rows="5"><%= p.desc_en %></textarea></div>
          <div><label>Description (Amharic)</label><textarea name="desc_am" rows="5"><%= p.desc_am %></textarea></div>
        </div>
        <div class="row2">
          <div>
            <label>Category</label>
            <select name="category">
              <% categories.forEach(function(c){ %><option value="<%= c.key %>" <%= p.category === c.key ? 'selected' : '' %>><%= c.en %></option><% }) %>
            </select>
          </div>
          <div><label>Web address (slug)</label><input type="text" name="slug" value="<%= p.slug %>"><p class="hint">Shows as /products/<%= p.slug %>. Changing it changes the page address.</p></div>
        </div>
        <div class="row2">
          <div><label>Price</label><input type="number" step="0.01" name="price" value="<%= p.price %>"></div>
          <div><label>Currency</label><input type="text" name="currency" value="<%= p.currency %>"></div>
        </div>
        <div class="row2">
          <div><label>Display Order</label><input type="number" name="order" value="<%= p.order %>"></div>
          <div>
            <label>Cover image (optional)</label>
            <% if (p.image) { %><img src="<%= p.image %>" class="thumb" style="margin-bottom:8px;" alt=""><% } %>
            <%- include('_dropzone', { name: 'image_file', kind: 'image', maxmb: 5, hint: 'PNG, JPG, WEBP or GIF, up to 5 MB', required: false }) %>
          </div>
        </div>
        <label>Downloadable file</label>
        <p class="hint" style="margin-top:0;">Current: <strong><%= p.file_name || 'none uploaded' %></strong> <% if (p.file_type) { %>(<%= p.file_type %>)<% } %>. Choose a new file only if you want to replace it.</p>
        <%- include('_dropzone', { name: 'product_file', kind: 'file', maxmb: 15, hint: 'Excel, Word, PDF or ZIP, up to 15 MB', required: false }) %>
        <label style="display:flex; align-items:center; gap:8px; text-transform:none; font-weight:400;">
          <input type="checkbox" name="active" style="width:auto; margin:0;" <%= p.active ? 'checked' : '' %>> Visible on site
        </label>
        <div class="btn-row">
          <button type="submit" class="btn btn-primary">Save</button>
          <% if (p.active) { %><a class="btn btn-outline" href="/products/<%= p.slug %>" target="_blank" rel="noopener">View page &#8599;</a><% } %>
        </div>
      </form>
      <form method="POST" action="/admin/products/<%= p.id %>/delete" style="display:inline;" onsubmit="return confirm('Delete this product and its file?');">
        <button type="submit" class="btn btn-danger" style="margin-top:10px;">Delete Product</button>
      </form>
    </div>
    <% }) %>

    <div class="card">
      <h2>Add a New Product</h2>
      <form method="POST" action="/admin/products" enctype="multipart/form-data">
        <div class="lang-col">
          <div><label>Title (English)</label><input type="text" name="title_en" required></div>
          <div><label>Title (Amharic)</label><input type="text" name="title_am"></div>
        </div>
        <div class="lang-col">
          <div><label>Description (English)</label><textarea name="desc_en" rows="5"></textarea></div>
          <div><label>Description (Amharic)</label><textarea name="desc_am" rows="5"></textarea></div>
        </div>
        <div class="row2">
          <div>
            <label>Category</label>
            <select name="category">
              <% categories.forEach(function(c){ %><option value="<%= c.key %>"><%= c.en %></option><% }) %>
            </select>
          </div>
          <div><label>Web address (slug, optional)</label><input type="text" name="slug" placeholder="made from the title if left empty"></div>
        </div>
        <div class="row2">
          <div><label>Price</label><input type="number" step="0.01" name="price" required></div>
          <div><label>Currency</label><input type="text" name="currency" value="ETB"></div>
        </div>
        <label>Downloadable file (Excel, Word, PDF or ZIP, max 15 MB)</label>
        <%- include('_dropzone', { name: 'product_file', kind: 'file', maxmb: 15, hint: 'Excel, Word, PDF or ZIP, up to 15 MB', required: true }) %>
        <label>Cover image (optional)</label>
        <%- include('_dropzone', { name: 'image_file', kind: 'image', maxmb: 5, hint: 'PNG, JPG, WEBP or GIF, up to 5 MB', required: false }) %>
        <button type="submit" class="btn btn-primary" style="margin-top:10px;">Add Product</button>
      </form>
    </div>
  </div>
</div>
<script>
(function(){
  var OK = ['xlsx','xls','xlsm','docx','doc','pdf','zip'];
  function fmt(n){ return n >= 1048576 ? (n/1048576).toFixed(1)+' MB' : Math.max(1,Math.round(n/1024))+' KB'; }
  document.querySelectorAll('.dz').forEach(function(dz){
    var input = dz.querySelector('.dz-input'), chosen = dz.querySelector('.dz-chosen'),
        err = dz.querySelector('.dz-error'), prev = dz.querySelector('.dz-preview');
    var kind = dz.getAttribute('data-kind'), maxMb = parseFloat(dz.getAttribute('data-max')) || 15;
    ['dragenter','dragover'].forEach(function(ev){ dz.addEventListener(ev, function(){ dz.classList.add('over'); }); });
    ['dragleave','drop'].forEach(function(ev){ dz.addEventListener(ev, function(){ dz.classList.remove('over'); }); });
    input.addEventListener('change', function(){
      err.hidden = true; chosen.hidden = true; prev.hidden = true; dz.classList.remove('has-file');
      var f = input.files && input.files[0];
      if(!f) return;
      var ext = (f.name.split('.').pop() || '').toLowerCase();
      var problem = '';
      if(f.size > maxMb*1048576) problem = 'This file is '+fmt(f.size)+'. The limit is '+maxMb+' MB.';
      else if(kind === 'file' && OK.indexOf(ext) === -1) problem = 'Use an Excel, Word, PDF or ZIP file (this one is ".'+ext+'").';
      else if(kind === 'image' && f.type && f.type.indexOf('image/') !== 0) problem = 'Please choose an image file.';
      if(problem){ err.textContent = problem; err.hidden = false; input.value = ''; return; }
      chosen.textContent = '\u2713 ' + f.name + '  (' + fmt(f.size) + ')'; chosen.hidden = false; dz.classList.add('has-file');
      if(kind === 'image' && window.URL){ prev.src = URL.createObjectURL(f); prev.hidden = false; }
    });
  });
})();
</script>
</body>
</html>
