<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Services — Norden Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="admin-shell">
  <%- include('_sidebar', { active: 'services' }) %>
  <div class="admin-main">
    <h1>Services &amp; Prices</h1>
    <p class="admin-sub">These are the services customers see and pay for at checkout. Prices are in the currency shown (default ETB).</p>

    <% services.forEach(function(s){ %>
    <div class="card">
      <form method="POST" action="/admin/services/<%= s.id %>/update" enctype="multipart/form-data">
        <div class="lang-col">
          <div><label>Title (English)</label><input type="text" name="title_en" value="<%= s.title_en %>"></div>
          <div><label>Title (Amharic)</label><input type="text" name="title_am" value="<%= s.title_am %>"></div>
        </div>
        <div class="lang-col">
          <div><label>Description (English)</label><textarea name="desc_en"><%= s.desc_en %></textarea></div>
          <div><label>Description (Amharic)</label><textarea name="desc_am"><%= s.desc_am %></textarea></div>
        </div>
        <div class="row2">
          <div><label>Price</label><input type="number" step="0.01" name="price" value="<%= s.price %>"></div>
          <div><label>Currency</label><input type="text" name="currency" value="<%= s.currency %>"></div>
        </div>
        <div class="row2">
          <div><label>Display Order</label><input type="number" name="order" value="<%= s.order %>"></div>
          <div>
            <label>Photo</label>
            <% if (s.image) { %><img src="<%= s.image %>" class="thumb" style="margin-bottom:8px;"><% } %>
            <input type="file" name="image_file" accept="image/*">
          </div>
        </div>
        <label style="display:flex; align-items:center; gap:8px; text-transform:none; font-weight:400;">
          <input type="checkbox" name="active" style="width:auto; margin:0;" <%= s.active ? 'checked' : '' %>> Visible on site
        </label>
        <button type="submit" class="btn btn-primary">Save</button>
      </form>
      <form method="POST" action="/admin/services/<%= s.id %>/delete" style="display:inline;" onsubmit="return confirm('Delete this service?');">
        <button type="submit" class="btn btn-danger" style="margin-top:10px;">Delete Service</button>
      </form>
    </div>
    <% }) %>

    <div class="card">
      <h2>Add a New Service</h2>
      <form method="POST" action="/admin/services" enctype="multipart/form-data">
        <div class="lang-col">
          <div><label>Title (English)</label><input type="text" name="title_en" required></div>
          <div><label>Title (Amharic)</label><input type="text" name="title_am"></div>
        </div>
        <div class="lang-col">
          <div><label>Description (English)</label><textarea name="desc_en"></textarea></div>
          <div><label>Description (Amharic)</label><textarea name="desc_am"></textarea></div>
        </div>
        <div class="row2">
          <div><label>Price</label><input type="number" step="0.01" name="price" required></div>
          <div><label>Currency</label><input type="text" name="currency" value="ETB"></div>
        </div>
        <label>Photo</label>
        <input type="file" name="image_file" accept="image/*">
        <button type="submit" class="btn btn-primary" style="margin-top:10px;">Add Service</button>
      </form>
    </div>
  </div>
</div>
</body>
</html>
