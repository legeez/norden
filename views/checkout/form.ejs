<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<title>Checkout — <%= service.title_en %></title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="checkout-wrap">
  <a href="<%= service.back %>" class="nav-link" style="color:var(--steel); font-size:12px; display:inline-block; padding:10px 0;">&larr; Back</a>
  <div class="checkout-box" style="margin-top:8px;">
    <h1><%= service.title_en %></h1>
    <div class="svc-price"><%= service.price.toLocaleString('en-US') %> <%= service.currency %></div>
    <p class="lead" style="margin-bottom:20px; font-size:14px;"><%= service.desc_en %></p>
    <% if (service.kind === 'product') { %><p class="form-note" style="text-align:left; margin:-6px 0 20px;">You will get an instant download link (<%= service.file_type || 'file' %>) once payment is confirmed.</p><% } %>

    <% if (error) { %><div class="error" role="alert"><%= error %></div><% } %>

    <form method="POST" action="<%= service.action %>">
      <div class="field" style="margin-bottom:14px;">
        <label for="f-name">Full Name</label>
        <input id="f-name" type="text" name="name" autocomplete="name" required>
      </div>
      <div class="field" style="margin-bottom:14px;">
        <label for="f-email">Email</label>
        <input id="f-email" type="email" name="email" autocomplete="email" inputmode="email" required>
      </div>
      <div class="field" style="margin-bottom:20px;">
        <label for="f-phone">Phone</label>
        <input id="f-phone" type="tel" name="phone" autocomplete="tel" inputmode="tel" required>
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%;">Pay with Chapa</button>
    </form>
    <p class="form-note">You'll be redirected to Chapa's secure checkout to complete payment.</p>
  </div>
</div>
</body>
</html>
