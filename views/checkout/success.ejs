<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Payment Successful</title>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="checkout-wrap">
  <div class="checkout-box checkout-result">
    <div class="icon">✅</div>
    <h1>Payment Received</h1>
    <p class="lead" style="margin:14px 0;">Thank you, <%= order.customer_name %>. Your payment for <strong><%= order.service_title %></strong> has been confirmed.</p>
    <p class="form-note">Reference: <%= order.tx_ref %></p>
    <a href="/" class="btn btn-primary" style="margin-top:20px;">Back to site</a>
  </div>
</div>
</body>
</html>
