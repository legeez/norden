<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<title>Payment Successful</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="checkout-wrap">
  <div class="checkout-box checkout-result">
    <div class="icon">✅</div>
    <h1>Payment Received</h1>
    <p class="lead" style="margin:14px 0;">Thank you, <%= order.customer_name %>. Your payment for <strong><%= order.service_title %></strong> has been confirmed.</p>
    <% if (downloadUrl) { %>
    <a href="<%= downloadUrl %>" class="btn btn-primary" style="margin:6px 0 12px; width:100%;">Download your file</a>
    <p class="form-note" style="margin-top:0;">Bookmark this page or save this link: you can download again from it later.<br><span style="word-break:break-all;"><%= downloadUrl %></span></p>
    <% } else { %>
    <p class="form-note">We will contact you shortly to start your service.</p>
    <% } %>
    <p class="form-note">Reference: <%= order.tx_ref %></p>
    <a href="/" class="btn btn-outline" style="margin-top:20px;">Back to site</a>
  </div>
</div>
</body>
</html>
