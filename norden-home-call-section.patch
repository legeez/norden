--- a/lib/calls.js
+++ b/lib/calls.js
@@ -232,6 +232,28 @@ async function deleteCategory(id) {
   if (error) throw error;
 }
 
+// ---------- Summary for the home page ----------
+// The home page is cached for a couple of minutes, so it never shows live "online/offline"
+// status (the Book a Call page does). Phone numbers are never included.
+function homeSummary(s, ready, cats, now) {
+  const phoneOn = flag(s.channel_phone), waOn = flag(s.channel_whatsapp);
+  const liveChannels = (phoneOn && telHref(s.call_phone)) || (waOn && waHref(s.call_whatsapp));
+  const livePrice = num(s.live_price), schedPrice = num(s.scheduled_price);
+  const min = (list) => (list.length ? Math.min.apply(null, list) : null);
+  const liveFrom = min(cats.length ? cats.map(c => (c.live_price !== null ? c.live_price : livePrice)) : [livePrice]);
+  const schedFrom = min(cats.length ? cats.map(c => (c.scheduled_price !== null ? c.scheduled_price : schedPrice)) : [schedPrice]);
+  const liveMinutes = min(cats.length ? cats.map(c => (c.live_minutes !== null ? c.live_minutes : clampInt(s.live_minutes, 1, 120, 10))) : [clampInt(s.live_minutes, 1, 120, 10)]);
+  const live = { on: !!(ready && liveChannels), from: liveFrom, minutes: liveMinutes };
+  const scheduled = {
+    on: !!(ready && flag(s.scheduled_enabled) && (phoneOn || waOn) && availableDays(s, now || new Date()).length > 0),
+    from: schedFrom, minutes: clampInt(s.slot_minutes, 10, 240, 30)
+  };
+  return {
+    show: live.on || scheduled.on, currency: s.currency || 'ETB', live, scheduled,
+    cats: cats.map(c => ({ title_en: c.title_en, title_am: c.title_am || c.title_en, desc_en: c.desc_en, desc_am: c.desc_am || c.desc_en }))
+  };
+}
+
 // ---------- Bookings ----------
 
 function slotError() { return Object.assign(new Error('SLOT_TAKEN'), { code: 'SLOT_TAKEN' }); }
@@ -330,6 +352,6 @@ module.exports = {
   intlDigits, telHref, waHref,
   parseHM, parseDateKey, dateKey, toLocal, generateSlots, availableDays, formatSlot, maxAhead,
   takenSlotSet, takenForDay,
-  listCategories, listCategoriesSafe, getCategory, createCategory, updateCategory, deleteCategory,
+  homeSummary, listCategories, listCategoriesSafe, getCategory, createCategory, updateCategory, deleteCategory,
   createBooking, getByTxRef, markPaid, markFailed, listBookings, updateCallStatus, countNewSafe
 };
